SECRET_KEY=your-secret-key-here
DATABASE_URL=postgres://postgres:your-db-password@localhost:5432/vunafresh
ALLOWED_HOSTS=localhost,127.0.0.1

# File storage: any S3-compatible bucket, e.g. Supabase Storage (leave blank in dev)
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=
# Supabase: https://<project-ref>.storage.supabase.co/storage/v1/s3
STORAGE_ENDPOINT_URL=
# Supabase: the project's region, e.g. eu-central-1 (R2: leave blank for "auto")
STORAGE_REGION=
# Supabase: path
STORAGE_ADDRESSING_STYLE=
# Public address of the bucket, without https://
# Supabase: <project-ref>.supabase.co/storage/v1/object/public/<bucket>
STORAGE_PUBLIC_DOMAIN=
# A second, PRIVATE bucket for proofs of payment and driver documents. Never public.
STORAGE_PRIVATE_BUCKET_NAME=

# Email (leave EMAIL_HOST blank in dev to print emails to the console)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Vuna Fresh <no-reply@vunafresh.co.za>
FRONTEND_URL=http://localhost:3000

# Payments: EFT/direct deposit only until PayFast is live
PAYFAST_ENABLED=False

# Bank account shown to buyers for EFT / direct deposit
PLATFORM_BANK_NAME=
PLATFORM_BANK_ACCOUNT_HOLDER=
PLATFORM_BANK_ACCOUNT_NUMBER=
PLATFORM_BANK_BRANCH_CODE=
PLATFORM_BANK_ACCOUNT_TYPE=
